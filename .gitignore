# ---------------------------------------------------------------------------
# Cude.new verification artifacts
#
# Policy: anything a script regenerates stays out of source control. Every entry
# below is reproducible with a single command, noted beside it.
#
#   verification-android/        node scripts/generate-android-verify.mjs   (~482 MB with Gradle/node_modules)
#   verification-vscode/         node scripts/cude-verify.mjs               (~24 MB with node_modules + .vsix)
#   verification-product-family/ node scripts/cude-architecture-verify.mjs  (regeneratedon every run, timestamped)
#   .qa/                         node scripts/qa-final-v3.mjs               (screenshots, local evidence only)
#
# verification-showcase/ source IS tracked: it is small (~74 KB) and
# scripts/test-export.mjs reads it directly. Its build output is ignored.
# ---------------------------------------------------------------------------
.qa/
verification-android/
verification-vscode/
verification-product-family/
verification-design-approval/
verification-showcase/node_modules/
verification-showcase/dist/

# Build output inside any generated verification project.
verification-*/**/node_modules/
verification-*/**/build/
verification-*/**/out/
verification-*/**/.gradle/
android-sdk/
dist/win-unpacked/
*.vsix
*.apk
*.aab
*.zip
!examples/**/*.zip

# Generated analysis and interpreter output
__pycache__/
*.py[cod]
dead.json
unreached.json
vite.config.ts.timestamp-*.mjs

# Android / Electron build output
android/app/build/
.expo/

# docs ignore
site

# Local helper output
app/commit.json
changelogUI.md
docs/instructions/Roadmap.md
.cursorrules

.qodo

# TypeScript incremental build state
tsconfig.tsbuildinfo
